APP_NAME="IMBY API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
API_VERSION=0.1.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default connection = shared IMBY data warehouse (owned by agents_v2 schema)
DB_CONNECTION=data

DATA_DB_CONNECTION=data
DATA_DB_HOST=postgis
DATA_DB_PORT=5432
DATA_DB_DATABASE=imby_data_v2
DATA_DB_USERNAME=imby
DATA_DB_PASSWORD=secret

# File/sync drivers avoid colliding with agents_v2 ops tables
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Passkeys / WebAuthn (login + device registration). RP ID is hostname only.
# Include every SPA origin that will complete ceremonies.
PASSKEYS_RELYING_PARTY_ID=localhost
PASSKEYS_ALLOWED_ORIGINS="${APP_URL},http://localhost:5174,http://127.0.0.1:5174"
# FRONTEND_URL=http://localhost:5174
# SEARCH_ALERT_PER_SEARCH_LIMIT=20
# PASSKEYS_USER_HANDLE_SECRET=
# PASSKEYS_TIMEOUT=60000

# Insights (laravel/ai tool-calling chat over warehouse APIs). Off by default.
# Requires a cloud AI key (OpenAI by default).
INSIGHTS_ENABLED=false
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
INSIGHTS_PROVIDER=openai
INSIGHTS_MODEL=gpt-4.1-mini
# INSIGHTS_TIMEOUT=60

# Optional: Anthropic instead of OpenAI
# AI_DEFAULT_PROVIDER=anthropic
# INSIGHTS_PROVIDER=anthropic
# INSIGHTS_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=

# Optional local Ollama (not the default Insights path)
# AI_DEFAULT_PROVIDER=ollama
# INSIGHTS_PROVIDER=ollama
# INSIGHTS_MODEL=qwen2.5:14b
# OLLAMA_URL=http://ollama:11434
# docker compose --profile insights up -d

# Read-only warehouse role used to execute AI-generated SQL.
# Create with agents_v2/docker/postgres/init/02-create-readonly-role.sh (or equivalent).
# For local Docker, password can match DATA_DB_PASSWORD.
DATA_RO_DB_USERNAME=imby_readonly
DATA_RO_DB_PASSWORD=secret

# Warehouse map / list tuning
IMBY_MARKER_LIMIT=500

# Log guest application detail views to users_log (action=application).
# Default: user_id NULL. Optional bucket: ACTIVITY_ANONYMOUS_USER_ID=<users.id>
ACTIVITY_LOG_ANONYMOUS_VIEWS=true
# ACTIVITY_ANONYMOUS_USER_ID=
IMBY_DEFAULT_SUBMITTED_DAYS=365
IMBY_LIST_PER_PAGE=25
IMBY_LIST_MAX_PER_PAGE=100
IMBY_CSV_LIMIT=5000

# Geocoding (Nominatim / OpenStreetMap) — called server-side only
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_USER_AGENT="IMBY/2.0 (https://imby.com.au; geocode@imby.com.au)"
GEOCODE_COUNTRYCODES=au
GEOCODE_CACHE_TTL=604800
GEOCODE_TIMEOUT=8
GEOCODE_RATE_PER_MINUTE=60

# Stripe / Laravel Cashier (Checkout + Customer Portal + webhooks)
STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
CASHIER_CURRENCY=aud
CASHIER_CURRENCY_LOCALE=en_AU
STRIPE_TRIAL_DAYS=14
STRIPE_ALLOW_PROMOTION_CODES=true
# Create Products + Prices in Stripe Dashboard, then paste Price IDs (price_…):
STRIPE_PRICE_CORE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
# Optional display strings for GET /api/billing/plans
# STRIPE_PRICE_CORE_DISPLAY="$9 / month"
# STRIPE_PRICE_PRO_DISPLAY="$19 / month"
# STRIPE_PRICE_BUSINESS_DISPLAY="$49 / month"
# STRIPE_PRICE_ENTERPRISE_DISPLAY="$99 / month"
# Webhook URL (Cashier subscriptions): POST {APP_URL}/stripe/webhook
# Recommended events: customer.*, invoice.*, checkout.session.*, customer.subscription.*, payment_method.*

# One-time public property reports (Payment Element modal)
STRIPE_PROPERTY_REPORT_AMOUNT_CENTS=2900
STRIPE_PROPERTY_REPORT_CURRENCY=aud
# Optional separate webhook secret; otherwise STRIPE_WEBHOOK_SECRET is used.
# STRIPE_REPORTS_WEBHOOK_SECRET=
# Report webhook: POST {APP_URL}/api/reports/stripe/webhook
# Also enable: payment_intent.succeeded, payment_intent.payment_failed
REPORTS_RATE_PER_MINUTE=20
