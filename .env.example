APP_NAME="IMBY API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
API_VERSION=0.1.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default connection = shared IMBY data warehouse (owned by agents_v2 schema)
DB_CONNECTION=data

DATA_DB_CONNECTION=data
DATA_DB_HOST=postgis
DATA_DB_PORT=5432
DATA_DB_DATABASE=imby_data_v2
DATA_DB_USERNAME=imby
DATA_DB_PASSWORD=secret

# File/sync drivers avoid colliding with agents_v2 ops tables
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Experimental Insights (NL→SQL chat). Off by default.
# Enable routes + browser UI, then start Ollama: docker compose --profile insights up -d
INSIGHTS_ENABLED=false

# Local AI (Ollama + Llama) — only needed when INSIGHTS_ENABLED=true
AI_DEFAULT_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Read-only warehouse role used to execute AI-generated SQL.
# Create with agents_v2/docker/postgres/init/02-create-readonly-role.sh (or equivalent).
# For local Docker, password can match DATA_DB_PASSWORD.
DATA_RO_DB_USERNAME=imby_readonly
DATA_RO_DB_PASSWORD=secret

# Warehouse map / list tuning
IMBY_MARKER_LIMIT=500
IMBY_DEFAULT_SUBMITTED_DAYS=365
IMBY_LIST_PER_PAGE=25
IMBY_LIST_MAX_PER_PAGE=100
IMBY_CSV_LIMIT=5000
